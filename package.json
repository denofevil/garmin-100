{
  "name": "garmin-swim-100",
  "version": "1.0.0",
  "description": "A Chrome Extension that provides 100 splits for Garmin Connect",
  "main": "dist/background.js",
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack --mode development --watch",
    "pack": "rm garmin100.zip; zip -r garmin100.zip . -i manifest.json -i dist/* -i src/assets/*"
  },
  "keywords": [
    "chrome-extension",
    "typescript",
    "webpack",
    "react",
    "redux"
  ],
  "author": "Dennis Ushakov",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1"
  }
}
