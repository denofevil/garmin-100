{
  "name": "garmin-swim-100",
  "version": "1.0.0",
  "description": "A Chrome Extension that provides 100 splits for Garmin Connect",
  "main": "dist/background.js",
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack --mode development --watch",
    "pack": "rm garmin100.zip; zip -r garmin100.zip . -i manifest.json -i dist/* -i src/assets/*"
  },
  "keywords": [
    "chrome-extension",
    "typescript",
    "webpack"
  ],
  "author": "Dennis Ushakov",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/chrome": "^0.0.332",
    "css-loader": "^6.11.0",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
